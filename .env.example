# Supabase project URL and publishable key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only elevated API key; keep out of browser code, Git and NEXT_PUBLIC variables.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative if the project has not switched to the new secret-key format:
# SUPABASE_SERVICE_ROLE_KEY=

# Optional public college defaults; database settings take precedence after migrations are applied.
NEXT_PUBLIC_COLLEGE_NAME=ALAN.AI
NEXT_PUBLIC_COLLEGE_TIME_ZONE=Asia/Kolkata

# Server-side OpenAI-compatible API. Supply the three keys only through protected project settings.
ALAN_AI_API_BASE=https://api.openai.com/v1
ALAN_AI_MODEL=gpt-4o-mini
ALAN_AI_API_KEY_1=replace_with_server_only_secret
ALAN_AI_API_KEY_2=replace_with_server_only_secret
ALAN_AI_API_KEY_3=replace_with_server_only_secret
